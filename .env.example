# --- LOCAL (docker compose up -d) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/namoerp

# --- CLOUD (Supabase pooler string: Project Settings -> Database) ---
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# db:push / migrate ke liye direct (5432) string, optional:
# DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

PORT=4000

# --- TESTS (pnpm test:db) --- must be a LOCAL database whose name contains "test"; it is wiped and re-seeded
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/namoerp_test
