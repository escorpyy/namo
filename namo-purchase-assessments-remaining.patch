+  const r = spawnSync(cmd, { stdio: "inherit", shell: true, env });
+  if (r.status !== 0) process.exit(r.status ?? 1);
+};
+run("pnpm db:migrate");
+run("pnpm db:seed");
+console.log(`\nDatabase "${name}" has been reset and seeded.`);
