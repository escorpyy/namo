@@ -0,0 +1,24 @@
+import { createContext, useContext } from "react";
+import type { Row } from "../lib/form";
+
+// What a field passes to its picker to say "Ctrl+M creates a record of this master".
+export interface CreateMasterSpec {
+  /** shared/masters.ts key of the master to create */
+  key: string;
+  /** field -> value to pre-fill in the New form (e.g. a vendor is a Party of type VENDOR) */
+  defaults?: Record<string, string | boolean>;
+  /** The picker option value for a created row. Default: String(row.id). (A vendor option is the ledger id, not the party id.) */
+  valueFrom?: (row: Row) => string;
+}
+
+export interface QuickCreateRequest {
+  key: string;
+  /** what was typed in the picker's search box: becomes the name of the new record */
+  name?: string;
+  defaults?: Record<string, string | boolean>;
+}
+/** Opens the New form of a master in a dialog; resolves the saved row, or null when the user cancelled. */
+export type QuickCreateFn = (req: QuickCreateRequest) => Promise<Row | null>;
+
+export const QuickCreateContext = createContext<QuickCreateFn | null>(null);
+export const useQuickCreate = () => useContext(QuickCreateContext);
diff --git a/src/lib/masterEvents.ts b/src/lib/masterEvents.ts
new file mode 100644
index 0000000..a8172c4
--- /dev/null
+++ b/src/lib/masterEvents.ts
@@ -0,0 +1,24 @@
+import { useEffect, useRef } from "react";
+
+// A master record was just created without leaving the screen (Ctrl+M on a reference field). Everything that keeps its own copy of
+// that master's list (a purchase document's pick-lists, a master form's lookups, a Ctrl+M dialog) registers here and reloads it,
+// so the new record is in the options before the field is set to it.
+type Reloader = (masterKey: string) => Promise<void> | void;
+const reloaders = new Set<Reloader>();
+
+/** Resolves once every registered screen has reloaded; rejects if one could not. */
+export async function announceMasterChanged(masterKey: string): Promise<void> {
+  await Promise.all([...reloaders].map((fn) => fn(masterKey)));
+}
+
+/** Register a reloader for as long as the component is mounted (the latest `fn` is always the one called). */
+export function useOnMasterChanged(fn: Reloader, enabled = true) {
+  const latest = useRef(fn);
+  latest.current = fn;
+  useEffect(() => {
+    if (!enabled) return;
+    const reloader: Reloader = (key) => latest.current(key);
+    reloaders.add(reloader);
+    return () => { reloaders.delete(reloader); };
+  }, [enabled]);
+}
diff --git a/src/lib/masterLookups.ts b/src/lib/masterLookups.ts
new file mode 100644
index 0000000..1238698
--- /dev/null
+++ b/src/lib/masterLookups.ts
@@ -0,0 +1,37 @@
+import { MASTERS, matchWhere, type LookupWhere, type MasterDef, type Opt } from "../../shared/masters";
+import { recordTitle, type Row } from "./form";
+
+// The other masters a master's form reads its lookups from (fields, lines columns, and `loads`), same rule MasterScreen uses.
+export const lookupKeysOf = (def: MasterDef): string[] => {
+  const lineLookups = def.fields.flatMap((f) => (f.type === "lines" ? f.lines!.columns.filter((c) => c.type === "lookup").map((c) => c.lookup!) : []));
+  const own = def.fields.filter((f) => f.type === "lookup" && f.lookupScope !== "record").map((f) => f.lookup!);
+  return [...new Set([...own, ...lineLookups, ...(def.loads ?? [])])].filter((k) => k !== def.key);
+};
+
+// Options of every lookup field (and lines lookup column) of `def` from already-loaded rows: the same shape MasterScreen builds.
+export function buildLookups(def: MasterDef, rowsOf: (masterKey: string) => Row[]): Record<string, Opt[]> {
+  const out: Record<string, Opt[]> = {};
+  const build = (key: string, lookup: string, where: LookupWhere | undefined) => {
+    const target = MASTERS[lookup];
+    const rows = rowsOf(lookup).filter((r) => matchWhere(where, r));
+    // A child master (Sub Group) shows its parent's code too: "AG01 / SG01 — Cash-in-Hand"
+    const pf = target.parent && target.fields.find((x) => x.name === target.parent!.field);
+    const parents = pf ? rowsOf(pf.lookup!) : [];
+    const pTarget = pf ? MASTERS[pf.lookup!] : null;
+    out[key] = rows.map((r) => {
+      const par = pf ? parents.find((p) => p.id === r[pf.name]) : null;
+      const prefix = par && pTarget ? `${par[pTarget.labelFields[0]]} / ` : "";
+      const code = String(r[target.labelFields[0]] ?? "");
+      const name = String(r[target.labelFields[1]] ?? "");
+      const parentDetail = par && pTarget ? `${pTarget.title}: ${recordTitle(pTarget, par)}` : "";
+      const attributes = [r.type, r.category, r.glType, r.role].filter((v) => typeof v === "string" && v).join(" · ");
+      const searchText = Object.entries(r).filter(([k, v]) => !["id", "createdAt", "updatedAt"].includes(k) && ["string", "number", "boolean"].includes(typeof v)).map(([, v]) => String(v)).join(" ");
+      return { value: String(r.id), label: `${prefix}${recordTitle(target, r)}`, short: code, code, name, detail: [parentDetail, attributes].filter(Boolean).join(" · "), searchText, isActive: typeof r.isActive === "boolean" ? r.isActive : true };
+    });
+  };
+  for (const f of def.fields) {
+    if (f.type === "lookup" && f.lookupScope !== "record") build(f.name, f.lookup!, f.lookupWhere);
+    if (f.type === "lines") for (const c of f.lines!.columns) if (c.type === "lookup") build(`${f.name}.${c.name}`, c.lookup!, c.lookupWhere);
+  }
+  return out;
+}
